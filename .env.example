# Gemini API — from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=

# Neon Postgres — auto-set by the Neon integration on Vercel Marketplace
DATABASE_URL=

# Upstash Redis — auto-set by the Upstash integration on Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — auto-set by the Inngest integration on Vercel Marketplace
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Queues
QUEUE_REGION=iad1

# Model overrides (defaults in src/lib/gemini.ts)
MODEL_STRONG=gemini-3.8-flash
MODEL_LITE=gemini-3.5-flash-lite
MODEL_SUPPORT=gemma-4
